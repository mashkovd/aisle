#!/usr/bin/env bash
# stand-in for the real CLI in the demo recording; DEMO_MODE=work keeps a spinner running
printf '\e[1mcodex\e[0m  \e[2m%s\e[0m\n\n' "$*"
if [[ $DEMO_MODE == work ]]; then
  printf '› Add a dark mode toggle to the settings page\n\n'
  printf '• Edited src/theme.ts (+18 -2)\n• Edited src/settings/Appearance.tsx (+41 -0)\n\n'
  s=12; while :; do printf '\r• Working (%ds • esc to interrupt)' $s; s=$((s+1)); sleep 1; done
fi
printf '  Resumed conversation in %s\n\n> ' "$(basename "$PWD")"
exec sleep 3600
